```{r}
# ══════════════════════════════════════════════════════════════════════════════
# TRIPLE BLOCK HEATMAP — Lipid Genes | Iron Genes | Top 50 DEGs
# ══════════════════════════════════════════════════════════════════════════════

library(ComplexHeatmap)
library(circlize)
library(matrixStats)
library(dplyr)

# ── Gene sets ─────────────────────────────────────────────────────────────────
lipid_genes <- c(
  "Cd163", "Trem2", "Cd9", "Lpl", "Cd36",
  "Abca1", "Fabp1", "Fabp4", "Plin2", "Apoe",
  "Spp1", "Gpnmb", "Lgals1", "Lgals2", "Lgals3",
  "Lgals4", "Lgals5", "Mmp12", "Slc9a9" 
)

iron_genes <- c(
  "Fth1", "Slc40a1",
  "Tfrc", "Tfr2",
  "Slc39a14", "Slc39a8", "Slc11a2",
  "Heph", "Cp", "Ftl1",
  "Ncoa4", "Ireb2", "Aco1",
  "Hamp", "Hfe",
  "Hmox1", "Hmox2",
  "Slc48a1", "Flvcr1", "Gpr18", "Fbxl5"
)

# ── Shared colors ─────────────────────────────────────────────────────────────
col_fun_gs <- colorRamp2(
  c(-2, -1, 0, 1, 2),
  c("#2166AC", "#92C5DE", "white", "#F4A582", "#B2182B")
)

group_colors <- c(
  "ConVEH" = "#42d4f4",
  "ConNAG" = "#e6194B",
  "LAMVEH" = "#d95f02",
  "LAMNAG" = "#2BC016"
)

FC_CUT  <- 1
FDR_CUT <- 0.05

# ══════════════════════════════════════════════════════════════════════════════
# MASTER HELPER — 3-block heatmap
# ══════════════════════════════════════════════════════════════════════════════
make_triple_heatmap <- function(vsd_obj,
                                 res_obj,
                                 lipid_genes,
                                 iron_genes,
                                 group_levels,
                                 comp_title) {

  # ── 1. Lipid genes available ───────────────────────────────────────────────
  lipid_avail   <- intersect(lipid_genes, rownames(vsd_obj))
  lipid_missing <- setdiff(lipid_genes, rownames(vsd_obj))
  if (length(lipid_missing) > 0)
    message("  [Lipid] Not in vsd: ", paste(lipid_missing, collapse = ", "))
  cat("  Lipid genes found:", length(lipid_avail), "\n")

  # ── 2. Iron genes available ────────────────────────────────────────────────
  iron_avail   <- intersect(iron_genes, rownames(vsd_obj))
  iron_missing <- setdiff(iron_genes, rownames(vsd_obj))
  if (length(iron_missing) > 0)
    message("  [Iron] Not in vsd: ", paste(iron_missing, collapse = ", "))
  cat("  Iron genes found:", length(iron_avail), "\n")

  # ── 3. Top 50 DEGs by variance ───────────────────────────────────────────
  deg_df    <- as.data.frame(res_obj) %>%
    filter(!is.na(padj), padj < FDR_CUT, abs(log2FoldChange) > FC_CUT) %>%
    arrange(padj)
  genes_deg <- intersect(rownames(deg_df), rownames(vsd_obj))

  if (length(genes_deg) == 0) {
    warning("  No DEGs found — skipping: ", comp_title)
    return(invisible(NULL))
  }

  rv        <- rowVars(assay(vsd_obj)[genes_deg, , drop = FALSE])
  top100    <- genes_deg[order(rv, decreasing = TRUE)[1:min(50, length(rv))]]
  cat("  Top DEGs found:", length(top100), "\n")

  # ── 4. Remove overlap — lipid & iron take priority over DEG block ──────────
  # genes already in lipid or iron are removed from DEG block only
  deg_only  <- setdiff(top100,    c(lipid_avail, iron_avail))
  # iron block: remove genes already in lipid block
  iron_only <- setdiff(iron_avail, lipid_avail)

  cat("  Lipid block:", length(lipid_avail),
      "| Iron block:", length(iron_only),
      "| DEG block:",  length(deg_only), "\n")

  # ── 5. Build combined gene list + row split factor ─────────────────────────
  all_genes <- c(lipid_avail, iron_only, deg_only)

  row_split <- factor(
    c(rep("① Lipid Genes",        length(lipid_avail)),
      rep("② Iron Metabolism",    length(iron_only)),
      rep("③ Top 50 DEGs",       length(deg_only))),
    levels = c("① Lipid Genes", "② Iron Metabolism", "③ Top 50 DEGs")
  )
  cat("  Total rows:", length(all_genes), "\n")

  # ── 6. Matrix & z-score ───────────────────────────────────────────────────
  mat        <- assay(vsd_obj)[all_genes, , drop = FALSE]
  mat_scaled <- t(scale(t(mat)))
  mat_scaled <- pmax(pmin(mat_scaled, 2), -2)

  # ── 7. Column ordering ────────────────────────────────────────────────────
  cd       <- as.data.frame(colData(vsd_obj)[, c("CellType", "Treatment")])
  cd$Group <- factor(paste0(cd$CellType, cd$Treatment),
                     levels = group_levels)
  col_ord    <- order(cd$Group)
  mat_scaled <- mat_scaled[, col_ord, drop = FALSE]
  cd         <- cd[col_ord, , drop = FALSE]

  # ── 8. Top column annotation ──────────────────────────────────────────────
  col_anno <- HeatmapAnnotation(
    Group = cd$Group,
    col   = list(Group = group_colors),
    annotation_name_gp   = gpar(fontsize = 9, fontface = "bold"),
    annotation_name_side = "left",
    simple_anno_size     = unit(5, "mm"),
    gap                  = unit(1, "mm"),
    border               = FALSE
  )

  # ── 9. Right annotation — LFC barplot ─────────────────────────────────────
  df_res  <- as.data.frame(res_obj)
  lfc_vec <- df_res[all_genes, "log2FoldChange"]
  lfc_vec[is.na(lfc_vec)] <- 0

  row_anno <- rowAnnotation(
    "log2FC" = anno_barplot(
      lfc_vec, baseline = 0,
      gp    = gpar(fill = ifelse(lfc_vec > 0, "#B2182B", "#2166AC"),
                   col = NA),
      width = unit(2.5, "cm")
    ),
    annotation_name_gp  = gpar(fontsize = 8, fontface = "bold"),
    annotation_name_rot = 0
  )

  # ── 10. Left annotation — significance stars ───────────────────────────────
  stars_vec <- ifelse(
    !is.na(df_res[all_genes, "padj"]) &
    df_res[all_genes, "padj"] < FDR_CUT &
    abs(df_res[all_genes, "log2FoldChange"]) > FC_CUT, "*", ""
  )
  left_anno <- rowAnnotation(
    Sig = anno_text(stars_vec, gp = gpar(fontsize = 10, col = "#B2182B"))
  )

  # ── 11. Row title colors per block ────────────────────────────────────────
  # lipid = teal, iron = brown, DEGs = dark grey
  row_title_colors <- c(
    "① Lipid Genes"     = "#0077A8",
    "② Iron Metabolism" = "#E83A3F",
    "③ Top 50 DEGs"    = "#FF930F"
  )

  # ── 12. Heatmap ───────────────────────────────────────────────────────────
  ht <- Heatmap(
    mat_scaled,
    col  = col_fun_gs,
    name = "z-score\n(VST)",

    # columns
    cluster_columns          = FALSE,
    show_column_names        = TRUE,
    column_names_gp          = gpar(fontsize = 9),
    column_names_rot         = 45,
    top_annotation           = col_anno,
    column_split             = cd$Group,
    column_gap               = unit(3, "mm"),
    column_title             = NULL,

    # row split — 3 blocks, fixed order
    row_split                = row_split,
    cluster_row_slices       = FALSE,
    row_title_gp             = gpar(
                                 fontsize  = 10,
                                 fontface  = "bold",
                                 col       = c("#0077A8",
                                               "#E83A3F",
                                               "#FF930F")
                               ),
    row_title_rot            = 0,
    row_gap                  = unit(6, "mm"),

    # clustering within each block independently
    cluster_rows             = TRUE,
    clustering_distance_rows = "pearson",
    clustering_method_rows   = "ward.D2",

    show_row_names           = TRUE,
    row_names_gp             = gpar(fontsize = 8, fontface = "italic"),
    row_names_side           = "left",
    row_dend_side            = "right",
    row_dend_width           = unit(1.5, "cm"),

    right_annotation         = row_anno,
    left_annotation          = left_anno,

    heatmap_legend_param = list(
      title         = "z-score",
      title_gp      = gpar(fontsize = 9, fontface = "bold"),
      labels_gp     = gpar(fontsize = 8),
      legend_height = unit(4, "cm"),
      at            = c(-2, -1, 0, 1, 2),
      border        = "black"
    ),
    width   = unit(10, "cm"),
    border  = TRUE,
    rect_gp = gpar(col = NA)
  )

  return(ht)
}

