pca_data <- plotPCA(
    vsd_lamNAGvslamVEH,
    intgroup = c("CellType", "Treatment"),
    ntop = nrow(vsd_lamNAGvslamVEH),
    returnData = TRUE
)

percentVar <- round(
    100 * attr(pca_data, "percentVar")
)

pca_data$Condition <- paste0(pca_data$CellType, pca_data$Treatment)
pca_data$Condition <- factor(
  pca_data$Condition,
  levels = c("LAMVEH", "LAMNAG")
)


p_pca <- ggplot(
    pca_data,
    aes(
        x = PC1,
        y = PC2,
        color = Condition,
        fill  = Condition,
        shape = Condition
    )
) +

    # Ellipse per group
    stat_ellipse(
        aes(group = Condition),
        type = "norm",
        geom = "polygon",
        alpha = 0.12,
        linewidth = 0.5
    ) +

    # PCA points
