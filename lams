percentVar <- round(100 * attr(pca_data, "percentVar"))
 
# Combine group label for shape
pca_data$Group <- paste0(pca_data$CellType, "_", pca_data$Treatment)
 
p_pca <- ggplot(pca_data,
                aes(x = PC1, y = PC2,
                    color = CellType,
                    shape = Treatment,
                    fill  = CellType)) +
  # Convex hull per CellType
  #stat_ellipse(aes(group = CellType), type = "norm",
  #             linetype = 2, linewidth = 0.5, alpha = 0.15,
  #             geom = "polygon") +
  geom_point(size = 5, stroke = 0.8, color = "black",
             aes(fill = CellType), alpha = 0.95) +
  geom_text_repel(aes(label = name),
                  size = 3, color = "black",
                  box.padding = 0.4,
                  max.overlaps = 20,
                  segment.color = "grey60",
                  segment.size  = 0.3) +
  scale_color_manual(values = col_celltype) +
  scale_fill_manual(values  = col_celltype) +
  scale_shape_manual(values = c("VEH" = 21, "NAG" = 24)) +
  xlab(paste0("PC1  (", percentVar[1], "% variance)")) +
  ylab(paste0("PC2  (", percentVar[2], "% variance)")) +
  ggtitle("Principal Component Analysis") +
  guides(
    fill  = guide_legend(title = "Cell Type",
                         override.aes = list(shape = 21, size = 4)),
    shape = guide_legend(title = "Treatment",
                         override.aes = list(size = 4))
  ) +
  theme(legend.position = "right")
p_pca
