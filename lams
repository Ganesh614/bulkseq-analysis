# SAVE HELPER
# ══════════════════════════════════════════════════════════════════════════════
save_triple_heatmap <- function(ht, outdir, filename_base, comp_title) {
  if (is.null(ht)) return(invisible(NULL))
  n_rows <- nrow(ht@matrix)
  h      <-12
  w      <- 10

  for (ext in c("pdf", "png")) {
    fpath <- file.path(outdir, paste0(filename_base, ".", ext))
    if (ext == "pdf") pdf(fpath, width = w, height = h)
    else              png(fpath, width = w, height = h,
                          units = "in", res = 600)
    draw(ht,
         heatmap_legend_side    = "right",
         annotation_legend_side = "right",
         merge_legend           = TRUE,
         column_title           = comp_title,
         column_title_gp        = gpar(fontsize = 14, fontface = "bold"),
         padding                = unit(c(5, 5, 5, 5), "mm"))
    dev.off()
  }
  cat("  ✅ Saved:", filename_base, "\n")
}

