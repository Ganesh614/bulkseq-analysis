library(DESeq2)
library(EnhancedVolcano)
library(ggplot2)
library(dplyr)
library(grid)

# =========================================================
# PARAMETERS
# =========================================================
FC_CUT  <- 1
FDR_CUT <- 0.05

# =========================================================
# FUNCTION
# =========================================================
make_pub_volcano <- function(
    res,
    title,
    subtitle = "",
    highlight_gene = "Fbxl5",
    fc_cut = FC_CUT,
    fdr_cut = FDR_CUT
){

  # =======================================================
  # DATA
  # =======================================================
  df <- as.data.frame(res) %>%
    mutate(gene = rownames(.)) %>%
    filter(
      !is.na(log2FoldChange),
      !is.na(padj)
    )

  # cap extreme p-values
  df$padj[df$padj < 1e-300] <- 1e-300

  # =======================================================
  # COUNTS
  # =======================================================
  n_up <- sum(
    df$padj < fdr_cut &
      df$log2FoldChange > fc_cut
  )

  n_down <- sum(
    df$padj < fdr_cut &
      df$log2FoldChange < -fc_cut
  )

  # =======================================================
  # AXIS
  # =======================================================
  x_lim <- ceiling(
    max(abs(df$log2FoldChange))
  ) + 1

  # =======================================================
  # COLORS
  # =======================================================
  keyvals <- rep("grey80", nrow(df))

  # significant genes
  keyvals[
    df$padj < fdr_cut &
      abs(df$log2FoldChange) > fc_cut
  ] <- "firebrick2"

  # highlighted gene
  keyvals[df$gene == highlight_gene] <- "#1565C0"

  names(keyvals) <- rep("NS", length(keyvals))

  names(keyvals)[
    keyvals == "firebrick2"
  ] <- "Significant"

  names(keyvals)[
    keyvals == "#1565C0"
  ] <- highlight_gene

  # =======================================================
  # POINT SIZES
  # =======================================================
  point_sizes <- rep(1.8, nrow(df))

  point_sizes[
    df$padj < fdr_cut &
      abs(df$log2FoldChange) > fc_cut
  ] <- 2.2

  point_sizes[
    df$gene == highlight_gene
  ] <- 5

  # =======================================================
  # LABELS
  # =======================================================
  custom_lab <- ifelse(
    df$gene == highlight_gene,
    highlight_gene,
    ""
  )

  # =======================================================
  # PLOT
  # =======================================================
  p <- EnhancedVolcano(
    df,

    lab = custom_lab,

    selectLab = highlight_gene,

    x = "log2FoldChange",
    y = "padj",

    title = title,
    subtitle = subtitle,

    pCutoff = fdr_cut,
    FCcutoff = fc_cut,

    colCustom = keyvals,

    pointSize = point_sizes,

    labSize = 5,

    boxedLabels = TRUE,

    drawConnectors = TRUE,

    widthConnectors = 0.7,

    colConnectors = "#1565C0",

    endsConnectors = "first",

    max.overlaps = Inf,

    colAlpha = 0.9,

    legendPosition = "none",

    gridlines.major = FALSE,
    gridlines.minor = FALSE,

    cutoffLineType = "dashed",
    cutoffLineCol = "black",
    cutoffLineWidth = 0.5,

    border = "full",
    borderWidth = 0.8,
    borderColour = "black",

    xlim = c(-x_lim, x_lim),

    xlab = expression(Log[2]~Fold~Change),

    titleLabSize = 20,
    subtitleLabSize = 12,

    caption = paste0(
      "Upregulated: ",
      n_up,
      "   |   Downregulated: ",
      n_down
    ),

    captionLabSize = 11
  ) +

    theme_bw(base_size = 14) +

    theme(

      plot.title = element_text(
        face = "bold",
        size = 20,
        hjust = 0.5
      ),

      plot.subtitle = element_text(
        size = 12,
        hjust = 0.5,
        colour = "grey30"
      ),

      plot.caption = element_text(
        size = 11,
        face = "plain",
        hjust = 0.5,
        colour = "black"
      ),

      axis.title = element_text(
        face = "bold",
        size = 16
      ),

      axis.text = element_text(
        size = 12,
        colour = "black"
      ),

      panel.grid = element_blank(),

      panel.border = element_rect(
        colour = "black",
        linewidth = 0.8,
        fill = NA
      ),

      plot.margin = margin(
        15,
        15,
        15,
        15
      )
    )

  return(p)
}

