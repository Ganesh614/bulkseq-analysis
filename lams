## identify differentially expressed gene
```{r}
# A. NAG effect in BMDM — simple coef → apeglm
results_LAMVEH_vs_LAMNAG <- results(
  dds_lamNAGvslamVEH,
  name = "Treatment_NAG_vs_VEH"
)
 
# B. NAG effect in LAM — list contrast → ashr
results_conVEH_vs_LAMVEH <- results(
  dds_lamvehvsconveh,
  name = "CellType_LAM_vs_Con")
  
 
# C. Baseline LAM signature — simple coef → apeglm
results_conNAG_vs_LAMNAG <- results(
  dds_lamNAGvsconNAG,
  name = "CellType_LAM_vs_Con"
)
 
# D. LAM identity after NAG — list contrast → ashr
results_conVEH_vs_conNAG <- results(
  dds_conVEH_vs_conNAG,
  name = "Treatment_NAG_vs_VEH")

write.csv(results_LAMVEH_vs_LAMNAG, "D:/ASHISH/lams_analysis/new_analysis/LAMVEH_vs_LAMNAG/results_LAMVEH_vs_LAMNAG.csv", row.names = FALSE)
